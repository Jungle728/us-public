--- /dev/null
+++ b/scripts/validate-hysteria2.cjs
@@ -0,0 +1,145 @@
+#!/usr/bin/env node
+'use strict';
+
+const assert = require('node:assert/strict');
+
+require('./register-typescript.cjs');
+
+const { createCoreConfig } = require('../src/common/helpers/core-config/core-config.factory.ts');
+const {
+    SingBoxGeneratorService,
+} = require('../src/modules/subscription-template/generators/singbox.generator.service.ts');
+const {
+    ResolveProxyConfigService,
+} = require('../src/modules/subscription-template/resolve-proxy/resolve-proxy-config.service.ts');
+
+const inbound = {
+    type: 'hysteria2',
+    tag: 'HY2_TEST',
+    listen: '0.0.0.0',
+    listen_port: 34443,
+    up_mbps: 100,
+    down_mbps: 100,
+    users: [],
+    tls: {
+        enabled: true,
+        server_name: 'example.com',
+        certificate_path: '/etc/remnawave/tls/fullchain.pem',
+        key_path: '/etc/remnawave/tls/privkey.pem',
+    },
+};
+
+const coreConfig = createCoreConfig('singbox', {
+    inbounds: [inbound],
+    outbounds: [{ type: 'direct', tag: 'DIRECT' }],
+});
+
+assert.deepEqual(coreConfig.getAllInbounds(), [
+    {
+        tag: 'HY2_TEST',
+        rawInbound: inbound,
+        type: 'hysteria2',
+        network: 'udp',
+        security: 'tls',
+        port: 34443,
+    },
+]);
+
+coreConfig.includeUserBatch(
+    [
+        {
+            id: 42n,
+            vlessUuid: '00000000-0000-4000-8000-000000000042',
+            trojanPassword: 'unused',
+            ssPassword: 'unused',
+            tags: ['HY2_TEST'],
+        },
+    ],
+    new Map(),
+);
+
+assert.deepEqual(coreConfig.getConfig().inbounds[0].users, [
+    {
+        name: '42',
+        password: '00000000-0000-4000-8000-000000000042',
+    },
+]);
+
+const resolver = new ResolveProxyConfigService({
+    getOrThrow: () => 'sub.example.com',
+});
+const user = { vlessUuid: '00000000-0000-4000-8000-000000000042' };
+const inputHost = {
+    vlessRouteId: null,
+    securityLayer: 'DEFAULT',
+    alpn: null,
+    fingerprint: null,
+    sni: null,
+    keepSniBlank: false,
+    overrideSniFromAddress: false,
+    pinnedPeerCertSha256: null,
+    verifyPeerCertByName: null,
+};
+const protocol = resolver.resolveProtocolOptions(inputHost, inbound, user);
+const transport = resolver.resolveSingBoxTransport(inbound, inputHost, protocol, user.vlessUuid);
+const security = resolver.resolveSingBoxSecurity(inbound, inputHost, 'example.com');
+
+assert.deepEqual(protocol, {
+    protocol: 'hysteria',
+    protocolOptions: { version: 2 },
+});
+assert.deepEqual(transport, {
+    transport: 'hysteria',
+    transportOptions: {
+        version: 2,
+        auth: user.vlessUuid,
+    },
+});
+assert.equal(security.security, 'tls');
+
+async function validateSubscriptionOutput() {
+    const service = new SingBoxGeneratorService({
+        getCachedTemplateByType: async () => ({
+            log: { level: 'warn' },
+            inbounds: [],
+            outbounds: [{ type: 'selector', tag: 'PROXY', outbounds: [] }],
+            route: { final: 'PROXY' },
+        }),
+    });
+    const generated = JSON.parse(
+        await service.generateConfig([
+            {
+                finalRemark: 'hy2-test',
+                address: 'example.com',
+                port: 34443,
+                ...protocol,
+                ...transport,
+                ...security,
+                streamOverrides: { finalMask: null, sockopt: null },
+                mux: null,
+                clientOverrides: {
+                    shuffleHost: false,
+                    mihomoX25519: false,
+                    mihomoIpVersion: null,
+                    serverDescription: null,
+                    xrayJsonTemplate: null,
+                    mapper: {},
+                },
+                metadata: { excludeFromSubscriptionTypes: [] },
+            },
+        ]),
+    );
+    const outbound = generated.outbounds.find((item) => item.type === 'hysteria2');
+    assert.ok(outbound, 'Hysteria2 subscription outbound is missing.');
+    assert.equal(outbound.password, user.vlessUuid);
+    assert.equal(outbound.server_port, 34443);
+}
+
+validateSubscriptionOutput()
+    .then(() => {
+        process.stdout.write('singbox_hysteria2_validation=passed\n');
+    })
+    .catch((error) => {
+        console.error(`singbox_hysteria2_validation=failed reason=${error.message}`);
+        process.exitCode = 1;
+    });
